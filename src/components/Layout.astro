---
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Milla · Cada paquete, una nueva historia",
  description = "Caso de estudio de una marca ficticia de paquetería. Explora los servicios Milla, calcula un envío y prueba el seguimiento de ejemplo.",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const indexable =
  import.meta.env.PUBLIC_INDEXABLE === "true" && Boolean(Astro.site);
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" />
    <meta
      name="robots"
      content={indexable ? "index, follow" : "noindex, follow"}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    {canonical && (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:url" content={canonical} />
        <meta
          property="og:image"
          content={new URL(`${base}social.png`, Astro.site)}
        />
      </>
    )}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Saltar al contenido
    </a>
    <noscript>
      <style>
        .header nav {
          display: flex !important;
        }
        .menu-toggle {
          display: none !important;
        }
      </style>
    </noscript>
    <slot />
  </body>
</html>
